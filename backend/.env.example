# ─── Samadhan Setu Backend — Environment Variables ────────────────────────────
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control.

# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://samadhan_user:YOUR_PASSWORD_HERE@localhost:5432/samadhan_setu_db

# ─── JWT ──────────────────────────────────────────────────────────────────────
# Generate a strong secret: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=REPLACE_WITH_A_STRONG_RANDOM_SECRET_KEY
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=480

# ─── Admin Bootstrap Credentials ──────────────────────────────────────────────
# Used ONLY by seed/create_admin.py — never exposed through any API endpoint.
ADMIN_EMAIL=admin@samadhan.gov.in
ADMIN_PASSWORD=REPLACE_WITH_STRONG_ADMIN_PASSWORD
ADMIN_FULL_NAME=Jharkhand Nodal Administrator

# ─── CORS (comma-separated) ───────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ─── File Upload ──────────────────────────────────────────────────────────────
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=10
